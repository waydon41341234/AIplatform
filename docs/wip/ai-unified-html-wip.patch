+.aig-cand > img { max-width: 100%; max-height: 100%; min-width: 0; object-fit: contain; flex: 1 1 0; }
+.aig-cand > img.aig-logo { flex: none; width: 100%; height: 100%; }
+.aig-cand .aig-img { position: absolute; inset: 0; background: center / cover no-repeat; }
+.aig-cand .ck { position: absolute; right: 4px; top: 4px; width: 18px; height: 18px; border-radius: 50%; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; z-index: 1; }
+.aig-cand .ck .ic { width: 12px; height: 12px; }
+.aig-cand .best { position: absolute; left: 4px; top: 4px; padding: 0 6px; border-radius: 999px; background: var(--brand); color: #fff; font-size: 10px; line-height: 16px; z-index: 1; white-space: nowrap; max-width: calc(100% - 30px); overflow: hidden; text-overflow: ellipsis; }
+.aig-cand.skeleton b { font-size: 12px; color: var(--text-3); font-weight: 500; }
+.aig-cand.is-fail { background: color-mix(in srgb, var(--error) 8%, var(--fill-3)); border: 1.5px dashed var(--error); color: var(--error); }
+.aig-cand.is-fail .ic { width: 22px; height: 22px; }
+.aig-two { display: flex; align-items: center; justify-content: center; gap: 4px; width: 100%; height: 100%; flex-direction: column; }
+.aig-two i { display: block; width: 90%; height: 40%; background: center / 100% 100% no-repeat; border-radius: 4px; }
+.aig-two.is-star { flex-direction: row; }
+.aig-two.is-star i { width: 40%; height: auto; aspect-ratio: 1; border-radius: 50%; background-color: #7a8290; }
+.aig-acts { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
+.aig-acts .btn { max-width: 100%; }
+.aig-acts .btn-primary { flex: 1 1 auto; justify-content: center; min-width: 0; white-space: normal; height: auto; min-height: 32px; text-align: center; }
+.aig-acts .btn-ghost { margin-left: auto; }
+.aig-list { display: flex; flex-direction: column; gap: 4px; }
+.aig-row { display: flex; align-items: center; gap: 6px; min-height: 44px; padding: 4px 8px; border-radius: var(--radius-sm); background: var(--fill-3); font-size: var(--fs-body-sm); min-width: 0; }
+.aig-row.is-fail { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--error) 50%, transparent); }
+.aig-row .nm { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.aig-row > .ic { flex: none; }
+.aig-row .btn { flex: none; padding: 0 8px; }
+.aig-c { flex: none; height: 32px; min-width: 32px; border-radius: 6px; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; gap: 1px; background: var(--bg-surface); }
+.aig-c img { width: 30px; height: 30px; object-fit: contain; }
+.aig-c .ic { width: 16px; height: 16px; }
+.aig-c .aig-img, .aig-c .aig-two { width: 32px; height: 32px; }
+.aig-c.is-fail { background: color-mix(in srgb, var(--error) 12%, transparent); color: var(--error); box-shadow: inset 0 0 0 1px var(--error); width: 32px; }
+.aig-c.skeleton { width: 32px; }
+.aig-c.is-old img { opacity: .8; }
+.aig-msheet .model-item { width: 100%; }
+/* 手机：AI 面板替换模块弹层内容，高度跟着内容走（最高 90dvh），整套结果列表时撑高 */
+.m-aig { max-height: 90dvh; }
+.m-aig .aig-hd { position: sticky; top: calc(-1 * var(--space-8)); z-index: 4; margin: calc(-1 * var(--space-8)) calc(-1 * var(--space-16)) 0; padding: var(--space-8) var(--space-16); background: var(--bg-surface); }
+@media (max-width: 420px) {
+  .aig-styles.is-more { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+  .aig-box .c-opt .ellipsis { max-width: 64px; }
+}
